# Civic Risk Scoring & Priority Engine Configuration
DATABASE_PATH=civic_risk.db
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
VITE_API_URL=http://127.0.0.1:8000
CORS_ORIGINS=*

# Google Gemini AI Integration for Automatic Citizen Complaint Analysis
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Production SMS Gateway (Optional: defaults to mock provider for local dev and automated tests)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_PHONE=+1234567890

# Cloud Evidence Storage (Optional: defaults to local encrypted disk storage)
STORAGE_PROVIDER=local
AWS_S3_BUCKET=civic-risk-evidence
AWS_REGION=ap-south-1
